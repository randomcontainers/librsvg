# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# check=error=true

ARG BASE_IMAGE=alpine:3.24

FROM ${BASE_IMAGE} AS rust
SHELL ["/bin/ash", "-euo", "pipefail", "-c"]
# GNU tar unpacks the Rust archives, which use GNU long names.
RUN apk add --no-cache \
      build-base \
      ca-certificates \
      curl \
      gpgv \
      python3 \
      scanelf \
      tar \
      xz

# Rust comes from static.rust-lang.org instead of the distro, so that both
# distros build with the same release. The release manifest is pinned in
# package.yml and signed with the Rust release key, fingerprint
# 108F 6620 5EAE B0AA A8DD 5E1C 85AB 96E6 FA1B E5FE; it lists the SHA-256 of
# every archive that rust-toolchain.sh installs.
ARG RUST_TOOLCHAIN_VERSION
ARG RUST_TOOLCHAIN_SHA256
ADD --checksum=sha256:${RUST_TOOLCHAIN_SHA256} https://static.rust-lang.org/dist/channel-rust-${RUST_TOOLCHAIN_VERSION}.toml /tmp/rust/
ADD https://static.rust-lang.org/dist/channel-rust-${RUST_TOOLCHAIN_VERSION}.toml.asc /tmp/rust/
COPY keys/rust.gpg /tmp/rust.gpg
ARG TARGETARCH
RUN --mount=type=bind,source=scripts/rust-toolchain.sh,target=/tmp/rust-toolchain.sh \
    case "${TARGETARCH}" in \
      amd64) arch=x86_64 ;; \
      arm64) arch=aarch64 ;; \
      *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    manifest="/tmp/rust/channel-rust-${RUST_TOOLCHAIN_VERSION}.toml"; \
    gpgv --keyring /tmp/rust.gpg "${manifest}.asc" "$manifest"; \
    sh /tmp/rust-toolchain.sh "$manifest" "${RUST_TOOLCHAIN_VERSION}" "${arch}-unknown-linux-musl" \
      /opt/rust /opt/rust-src > /tmp/rust-toolchain
# Rust links musl programs statically by default, with its own copy of musl
# and LLVM's libunwind. -crt-static links Alpine's musl and libgcc_s instead,
# so that musl fixes reach rsvg-convert through the base image, and the C
# libraries below can be linked as shared libraries. RUSTFLAGS takes the
# place of any rustflags in upstream's cargo configuration.
ENV PATH=/opt/rust/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    CARGO_HOME=/opt/cargo \
    CARGO_INCREMENTAL=0 \
    CARGO_NET_RETRY=5 \
    CARGO_TERM_COLOR=never \
    RUSTFLAGS="-C target-feature=-crt-static"

# cargo-auditable is built from its crate, with the crates in its Cargo.lock.
# It runs only in the build stage below.
FROM rust AS auditable
# hadolint checks each stage on its own, so the stages built on rust repeat
# its SHELL.
SHELL ["/bin/ash", "-euo", "pipefail", "-c"]
ARG CARGO_AUDITABLE_VERSION
ARG CARGO_AUDITABLE_SHA256
ADD --checksum=sha256:${CARGO_AUDITABLE_SHA256} https://static.crates.io/crates/cargo-auditable/cargo-auditable-${CARGO_AUDITABLE_VERSION}.crate /tmp/
RUN mkdir /src; \
    tar -xzf "/tmp/cargo-auditable-${CARGO_AUDITABLE_VERSION}.crate" -C /src; \
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')" \
      --manifest-path "/src/cargo-auditable-${CARGO_AUDITABLE_VERSION}/Cargo.toml"
ARG JOBS
RUN --network=none \
    cargo install --frozen --root /opt/cargo-auditable -j "${JOBS:-$(nproc)}" \
      --path "/src/cargo-auditable-${CARGO_AUDITABLE_VERSION}"

FROM rust AS build
SHELL ["/bin/ash", "-euo", "pipefail", "-c"]
# rsvg-convert links cairo, Pango, GLib, HarfBuzz, FreeType, Fontconfig,
# libxml2 and dav1d from the distro; the -sys crates find them with
# pkg-config.
RUN apk add --no-cache \
      cairo-dev \
      dav1d-dev \
      fontconfig-dev \
      freetype-dev \
      glib-dev \
      harfbuzz-dev \
      libxml2-dev \
      pango-dev \
      pkgconf

# GNOME publishes a .sha256sum file next to each tarball but no signature.
# Each release series has its own directory (2.63 for 2.63.3), which ADD
# cannot derive from VERSION, so the tarball is fetched with curl and checked
# against the SHA-256 pinned in package.yml.
ARG VERSION
ARG SOURCE_SHA256
RUN printf '%s\n' "${VERSION}" | grep -Eqx '[0-9]+\.[0-9]+\.[0-9]+' \
      || { echo "unexpected VERSION: ${VERSION}" >&2; exit 1; }; \
    printf '%s\n' "${SOURCE_SHA256}" | grep -Eqx '[0-9a-f]{64}' \
      || { echo "SOURCE_SHA256 must be the tarball's sha256" >&2; exit 1; }; \
    url="https://download.gnome.org/sources/librsvg/${VERSION%.*}/librsvg-${VERSION}.tar.xz"; \
    curl -fsSL --proto '=https' --proto-redir '=https' --retry 3 -o /tmp/librsvg.tar.xz "$url"; \
    echo "${SOURCE_SHA256}  /tmp/librsvg.tar.xz" | sha256sum -c -; \
    mkdir -p /src/librsvg; \
    tar -xJf /tmp/librsvg.tar.xz -C /src/librsvg --strip-components=1; \
    rm /tmp/librsvg.tar.xz; \
    echo "$url" > /tmp/source-url
WORKDIR /src/librsvg
# The tarball has no cargo configuration. One that a later release adds would
# apply to this build, so the build stops until the file has been read and a
# check of its SHA-256 added here. cargo fetch then downloads the crates in
# Cargo.lock for this platform and checks each against its checksum there.
RUN for f in .cargo/config .cargo/config.toml; do \
      if [ -e "$f" ]; then \
        cat "$f" >&2 || :; \
        echo "upstream added $f: read it, then add a check of its SHA-256 to the build" >&2; \
        exit 1; \
      fi; \
    done; \
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"; \
    cargo pkgid --frozen -p rsvg_convert > /tmp/pkgid; \
    case "$(cat /tmp/pkgid)" in \
      *"#${VERSION}" | *"@${VERSION}") ;; \
      *) echo "rsvg_convert is not version ${VERSION}: $(cat /tmp/pkgid)" >&2; exit 1 ;; \
    esac

# The build has no network: it reads only the crates fetched above, and
# dav1d-sys, which can clone and build dav1d itself when asked to, cannot
# download anything.
# cargo-auditable stores the list of crates in the binary's .dep-v0 section,
# where SBOM tools and image scanners find it. --features avif is what
# upstream's meson build passes when it finds dav1d. rsvg-convert drops an
# output format without a word when cairo lacks it, so each one is tried.
COPY --link --from=auditable /opt/cargo-auditable/bin/cargo-auditable /opt/rust/bin/
ARG JOBS
RUN --network=none \
    cargo auditable build --frozen --release -p rsvg_convert --bin rsvg-convert --features avif \
      -j "${JOBS:-$(nproc)}"; \
    install -D -m 755 target/release/rsvg-convert /out/usr/local/bin/rsvg-convert; \
    bin=/out/usr/local/bin/rsvg-convert; \
    "$bin" --version > /tmp/rsvg-convert-version; \
    test "$(head -n 1 /tmp/rsvg-convert-version)" = "rsvg-convert version ${VERSION}" \
      || { echo "expected rsvg-convert version ${VERSION}, got:" >&2; cat /tmp/rsvg-convert-version >&2; exit 1; }; \
    printf '<svg xmlns="http://www.w3.org/2000/svg" width="4" height="4"/>\n' > /tmp/empty.svg; \
    for f in png pdf ps eps svg; do \
      "$bin" -f "$f" -o "/tmp/empty.$f" /tmp/empty.svg || { echo "rsvg-convert cannot write $f" >&2; exit 1; }; \
    done; \
    readelf -hlSdW "$bin" > /tmp/rsvg-convert-elf; \
    grep -Eq '^ *Type: +DYN ' /tmp/rsvg-convert-elf || { cat /tmp/rsvg-convert-elf >&2; exit 1; }; \
    grep -Fq '[Requesting program interpreter: /lib/ld-musl-' /tmp/rsvg-convert-elf \
      || { echo "rsvg-convert is not linked against Alpine's musl" >&2; exit 1; }; \
    grep -Fq ' .dep-v0 ' /tmp/rsvg-convert-elf || { echo "rsvg-convert has no cargo-auditable data" >&2; exit 1; }; \
    grep -Fq 'Shared library: [libdav1d.so.' /tmp/rsvg-convert-elf \
      || { echo "rsvg-convert does not link the distro's libdav1d" >&2; exit 1; }

ARG BASE_IMAGE
ARG SOURCE_SHA256
ARG RUST_TOOLCHAIN_VERSION
ARG CARGO_AUDITABLE_VERSION
ARG CARGO_AUDITABLE_SHA256
# librsvg's license file comes from the tarball. cargo-licenses.py copies the
# license files of every crate that the binary records and of the Rust
# standard library, and stops when a crate's license is not covered by
# package.yml's license. Since that label has an LGPL term, it also copies the
# .crate file of every crate to crate-sources/, and the build checks that none
# is missing. licenses/crates holds the texts that two crates do not ship.
# runtime-deps lists the so: names rsvg-convert needs, plus the packages in
# runtime-deps.alpine.
RUN --network=none \
    --mount=type=bind,source=scripts/cargo-licenses.py,target=/tmp/cargo-licenses.py \
    --mount=type=bind,source=licenses,target=/tmp/licenses \
    --mount=type=bind,source=package.yml,target=/tmp/package.yml \
    --mount=type=bind,source=runtime-deps.alpine,target=/tmp/runtime-deps.extra \
    meta=/out/usr/local/share/randomcontainers/librsvg; \
    mkdir -p "$meta/licenses"; \
    cp COPYING.LIB "$meta/licenses/"; \
    python3 -I /tmp/cargo-licenses.py \
      --binary /out/usr/local/bin/rsvg-convert --workspace /src/librsvg --package-yml /tmp/package.yml \
      --extra /tmp/licenses/crates --rust-src /opt/rust-src \
      --licenses "$meta/licenses" --sources "$meta/crate-sources" > /tmp/crates; \
    crates=$(grep -c '^crate: [^ ]* [^ ]* crates\.io ' /tmp/crates); \
    copied=$(find "$meta/crate-sources" -name '*.crate' | wc -l); \
    test "$copied" -eq "$crates" \
      || { echo "the binary records $crates crates, but $copied .crate files were copied" >&2; exit 1; }; \
    echo "${VERSION}" > "$meta/version"; \
    { \
      cat /tmp/source-url; \
      echo "https://static.rust-lang.org/dist/channel-rust-${RUST_TOOLCHAIN_VERSION}.toml"; \
      sed -n 's/^rust-src: \([^ ]*\) .*$/\1/p' /tmp/rust-toolchain; \
      echo "https://static.crates.io/crates/cargo-auditable/cargo-auditable-${CARGO_AUDITABLE_VERSION}.crate"; \
      sed -n 's/^source: //p' /tmp/crates; \
      echo "https://github.com/randomcontainers/librsvg/releases/tag/v${VERSION}"; \
    } > "$meta/source"; \
    { \
      echo "base: ${BASE_IMAGE}"; \
      echo "tarball: librsvg-${VERSION}.tar.xz ${SOURCE_SHA256}"; \
      echo "rust: ${RUST_TOOLCHAIN_VERSION}"; \
      cat /tmp/rust-toolchain; \
      rustc -vV; \
      echo "linker: $(cc --version | sed -n 1p)"; \
      echo "cargo-auditable: ${CARGO_AUDITABLE_VERSION} ${CARGO_AUDITABLE_SHA256}"; \
      echo "rustflags: ${RUSTFLAGS:-}"; \
      echo "cargo: auditable build --frozen --release -p rsvg_convert --bin rsvg-convert --features avif"; \
      cat /tmp/rsvg-convert-version; \
      echo "crates:"; \
      sed -n 's/^crate: /  /p' /tmp/crates; \
    } > "$meta/buildinfo"; \
    scanelf --needed --nobanner --format '%n#p' --recursive /out/usr/local | tr ',' '\n' | sort -u > /tmp/needed; \
    while read -r so; do \
      if [ -n "$so" ] && [ -z "$(find /out -name "$so" -print -quit)" ]; then echo "so:$so"; fi; \
    done < /tmp/needed > /tmp/elf-deps; \
    test -s /tmp/elf-deps; \
    sort -u /tmp/elf-deps /tmp/runtime-deps.extra > "$meta/runtime-deps"

FROM ${BASE_IMAGE} AS slim
# fc-cache writes the font cache once here, so that each run does not scan
# the fonts again.
RUN --mount=type=bind,from=build,source=/out/usr/local/share/randomcontainers/librsvg/runtime-deps,target=/tmp/runtime-deps \
    set -eu; \
    xargs apk add --no-cache ca-certificates tini < /tmp/runtime-deps; \
    fc-cache -f; \
    addgroup -g 1000 app; \
    adduser -D -u 1000 -G app app; \
    install -d -m 1777 /work /cache
COPY --link --from=build /out/usr/local/ /usr/local/
ENV LANG=C.UTF-8 XDG_CACHE_HOME=/cache
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["tini", "--", "rsvg-convert"]
CMD ["--help"]
